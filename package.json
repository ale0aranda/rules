{
  "name": "@ale0aranda/rules",
  "version": "0.2.0",
  "description": "Shared Biome and Commitlint rules for Alejandro Aranda's projects.",
  "type": "module",
  "license": "MIT",
  "author": "Alejandro Aranda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale0aranda/rules.git"
  },
  "bugs": {
    "url": "https://github.com/ale0aranda/rules/issues"
  },
  "homepage": "https://github.com/ale0aranda/rules#readme",
  "keywords": [
    "biome",
    "commitlint",
    "conventional-commits",
    "emoji",
    "lint",
    "formatter",
    "shared-config",
    "typescript",
    "renovate",
    "configuration"
  ],
  "files": [
    "biome.json",
    "commitlint.mjs",
    "default.json",
    "typescript",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./biome": "./biome.json",
    "./commitlint": "./commitlint.mjs",
    "./typescript/base": "./typescript/base.json",
    "./typescript/web": "./typescript/web.json",
    "./typescript/node": "./typescript/node.json",
    "./typescript/library": "./typescript/library.json",
    "./package.json": "./package.json",
    "./renovate": "./default.json"
  },
  "scripts": {
    "check": "pnpm check:biome && pnpm check:commitlint && pnpm check:typescript && pnpm check:renovate && pnpm check:package",
    "check:biome": "biome ci .",
    "check:commitlint": "node --test test/commitlint.test.mjs",
    "check:typescript": "node --test test/typescript.test.mjs",
    "check:renovate": "renovate-config-validator --strict --no-global default.json && node --test test/renovate.test.mjs",
    "check:package": "node --test test/package.test.mjs",
    "format": "biome check --write .",
    "prepack": "pnpm check",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "renovate": "^44.56.3"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "conventional-commit-types-emoji": "^0.1.0",
    "lodash-es": "^4.18.1"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.7 <3",
    "@commitlint/cli": ">=21 <22",
    "typescript": ">=5.7 <8"
  }
}
