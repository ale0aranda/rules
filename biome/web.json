{
	"extends": ["./base.json"],
	"linter": {
		"rules": {
			"nursery": {
				"noTailwindArbitraryValue": {
					"level": "error",
					"options": {
						"functions": ["cn", "clsx"]
					}
				},
				"useSortedClasses": {
					"level": "warn",
					"options": {
						"functions": ["cn", "clsx"]
					}
				}
			}
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single"
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"formatter": {
			"enabled": true,
			"attributePosition": "multiline",
			"bracketSameLine": false,
			"indentScriptAndStyle": true
		},
		"linter": {
			"enabled": true
		}
	},
	"graphql": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single"
		},
		"linter": {
			"enabled": true
		}
	}
}
